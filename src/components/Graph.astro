---
import { LAYOUTS, NODE_RADIUS, WORD_PAD, graph, labelPlacement, linesFor, fontFor, ringsFrom, wordLayout } from '../data/graph';
import type { LayoutName } from '../data/graph';
import { MARKS } from '../data/marks';
import type { Mark, MarkId } from '../data/marks';

const rings = ringsFrom();
const byId = new Map(graph.nodes.map((n) => [n.id, n]));
const kindName = { company: 'company', work: 'project', domain: 'industry', skill: 'tool', oss: 'open-source project' };
const targetText = (t?: string) =>
  !t ? '' : t.startsWith('project:') ? ' Open the project.' : t.startsWith('job:') ? ' Go to experience.' : ' Show details.';
const layouts: LayoutName[] = ['desktop', 'phone'];
// One mark, scaled into a box: a logo keeps its own colours, a line icon is stroked in the text colour.
const draw = (id: MarkId, x: number, y: number, w: number, h: number, cls: string) => ({ m: MARKS[id] as Mark, x, y, w, h, cls });
// Companies and tools are their logos; only the two kinds of circle need a key.
const legend = [['work', 'Project'], ['domain', 'Industry']] as const;
---
<figure class="graph-box">
  {layouts.map((layout) => (
    <svg
      class="graph-svg"
      data-graph
      data-layout={layout}
      viewBox={`0 0 ${LAYOUTS[layout].width} ${LAYOUTS[layout].height}`}
      role="group"
      aria-label="Graph of Abdul's companies, projects, tools and industries"
    >
      <g aria-hidden="true">
        {['e', 'e-hi'].map((base) => graph.edges.map((e) => {
          // Draw from the end nearer the hub, so highlights always ripple outward.
          const outward = rings.get(e.from)! <= rings.get(e.to)!;
          const a = byId.get(outward ? e.from : e.to)![layout];
          const b = byId.get(outward ? e.to : e.from)![layout];
          const d = Math.max(rings.get(e.from)!, rings.get(e.to)!) - 1;
          return (
            <line
              class={[base, ...e.classes.map((c) => `e-${c}`)].join(' ')}
              data-from={e.from}
              data-to={e.to}
              x1={a.x} y1={a.y} x2={b.x} y2={b.y}
              pathLength="1"
              style={`--d:${d}`}
            />
          );
        }))}
      </g>
      {graph.nodes.map((n) => {
        const p = n[layout];
        const r = NODE_RADIUS[n.kind];
        const lp = labelPlacement(n, layout);
        const fs = fontFor(n, layout);
        return (
          <g
            class={`n n-${n.kind}`}
            data-node={n.id}
            data-target={n.target}
            tabindex="0"
            role={n.target ? 'link' : 'img'}
            aria-label={`${n.label}, ${kindName[n.kind]}.${targetText(n.target)}`}
            style={`--d:${rings.get(n.id)}`}
          >
            {n.word ? (() => {
              const wl = wordLayout(n, layout);
              const left = p.x - wl.w / 2;
              const marks = 'logo' in n.word
                ? [draw(n.word.logo, left, p.y - wl.h / 2, wl.w, wl.h, 'logo')]
                : n.word.icon ? [draw(n.word.icon, left, p.y - wl.icon / 2, wl.icon, wl.icon, (MARKS[n.word.icon] as Mark).line ? 'glyph line' : 'logo')] : [];
              return (
                <>
                  <rect class="plate" x={left - WORD_PAD} y={p.y - wl.h / 2 - WORD_PAD} width={wl.w + WORD_PAD * 2} height={wl.h + WORD_PAD * 2} rx="6" />
                  <g class="word">
                    {marks.map(({ m, x, y, w, h, cls }) => (
                      <svg class={cls} x={x} y={y} width={w} height={h} viewBox={m.viewBox} aria-hidden="true">
                        {m.paths ? m.paths.map((path) => <path d={path.d} fill={path.fill} />) : <Fragment set:html={m.line} />}
                      </svg>
                    ))}
                    {'text' in n.word && (
                      <text x={left + wl.icon + wl.gap} y={p.y + wl.fs * 0.36} style={`text-anchor:start;font-size:${wl.fs}px;font-weight:800`}>{n.word.text}</text>
                    )}
                  </g>
                </>
              );
            })() : (
              <>
                <circle class="halo" cx={p.x} cy={p.y} r={r + (layout === 'phone' ? 12 : 6)} />
                <circle class="core" cx={p.x} cy={p.y} r={r} />
                {n.mark && (() => {
                  const m: Mark = MARKS[n.mark];
                  const s = r * 1.15;
                  return (
                    <svg class="mark line" x={p.x - s / 2} y={p.y - s / 2} width={s} height={s} viewBox={m.viewBox} aria-hidden="true">
                      <Fragment set:html={m.line} />
                    </svg>
                  );
                })()}
                <text x={lp.x} y={lp.y} style={`text-anchor:${lp.anchor};font-size:${fs}px`}>
                  {linesFor(n, layout).map((line, i, lines) => <tspan x={lp.x} dy={i ? fs * 1.2 : 0}>{i < lines.length - 1 ? `${line} ` : line}</tspan>)}
                </text>
              </>
            )}
          </g>
        );
      })}
    </svg>
  ))}
  <figcaption class="graph-caption graph-after">
    Every line is a real connection between a company, a problem and the tool that solved it. Pick who you are above to trace your path through it.
  </figcaption>
  <ul class="legend graph-after" aria-hidden="true">
    {legend.map(([kind, label]) => (
      <li><svg class={`key n-${kind}`} viewBox="0 0 16 16"><circle class="core" cx="8" cy="8" r="6" /></svg>{label}</li>
    ))}
  </ul>
  <ul class="sr-only">
    {graph.edges.map((e) => <li>{byId.get(e.from)!.label} connects to {byId.get(e.to)!.label}</li>)}
  </ul>
</figure>
